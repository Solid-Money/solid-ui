# MeaWallet private package registry (auth via env: NEXUS_USERNAME, NEXUS_PASSWORD)
# npm config set //nexus.ext.meawallet.com/repository/react-native-mpp/:username $NEXUS_USERNAME
# npm config set //nexus.ext.meawallet.com/repository/react-native-mpp/:_password $(echo -n $NEXUS_PASSWORD | base64)
@meawallet:registry=https://nexus.ext.meawallet.com/repository/react-native-mpp/

# Allow temporary registry rate limits to recover during clean installs.
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
maxsockets=5
